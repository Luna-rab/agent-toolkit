{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rating", "body", "location"],
        "properties": {
          "rating": { "enum": ["must-fix", "should-fix", "nit"] },
          "body": { "type": "string", "minLength": 1 },
          "location": { "type": ["string", "null"], "minLength": 1 }
        }
      }
    }
  }
}

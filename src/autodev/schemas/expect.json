{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["report", "reportReason", "written", "awaitingExpectations", "defects"],
  "properties": {
    "report": { "enum": ["design-gap", "test-conflict", null] },
    "reportReason": { "type": ["string", "null"], "minLength": 1 },
    "written": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "awaitingExpectations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test", "command"],
        "properties": {
          "test": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 }
        }
      }
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test", "output", "acceptance"],
        "properties": {
          "test": { "type": "string", "minLength": 1 },
          "output": { "type": "string", "minLength": 1 },
          "acceptance": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
